<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusStack" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/midnight</item>
        <item name="android:navigationBarColor">@color/midnight</item>
        <item name="android:windowBackground">@color/midnight</item>
        <item name="android:colorBackground">@color/midnight</item>
    </style>

    <style name="TodayNoticeRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Compat.Notification.Title</item>
        <item name="android:textSize">18sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
